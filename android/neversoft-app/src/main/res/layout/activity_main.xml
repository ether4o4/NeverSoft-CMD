<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#202020"
    android:orientation="vertical">

    <!-- AI is always the TOP pane when split mode is enabled. -->
    <FrameLayout
        android:id="@+id/ai_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#202020"
        android:visibility="gone" />

    <!-- Windows 11-inspired horizontal split rail. It becomes draggable with AI mode. -->
    <View
        android:id="@+id/split_handle"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:background="#3A3A3A"
        android:visibility="gone" />

    <!-- Real PTY terminal is the BOTTOM pane in split mode and full-screen in Phase 1. -->
    <com.termux.view.TerminalView
        android:id="@+id/terminal_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0C0C0C"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#202020"
        android:gravity="center"
        android:padding="12dp"
        android:text="Preparing NeverSoft..."
        android:textColor="#F2F2F2"
        android:textSize="14sp" />

</LinearLayout>

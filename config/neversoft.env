# NeverSoft native Termux fork identity
# Keep these values short: Termux package paths have length constraints.

NEVERSOFT_APP_ID="com.neversoft.shell"
NEVERSOFT_APP_NAME="NeverSoft CMD"
NEVERSOFT_PROJECT_NAME="NeverSoft"
NEVERSOFT_DATA_DIR="/data/data/com.neversoft.shell"
NEVERSOFT_ROOTFS="/data/data/com.neversoft.shell/files"
NEVERSOFT_HOME="/data/data/com.neversoft.shell/files/home"
NEVERSOFT_PREFIX="/data/data/com.neversoft.shell/files/usr"

# Reproducible upstream inputs.
NEVERSOFT_TERMUX_APP_REPO="https://github.com/termux/termux-app.git"
NEVERSOFT_TERMUX_APP_REF="v0.118.3"
NEVERSOFT_TERMUX_PACKAGES_REPO="https://github.com/termux/termux-packages.git"
NEVERSOFT_TERMUX_PACKAGES_REF="master"

# Package repository identity. The first bootstrap does not require a published
# repo; this becomes active when NeverSoft package hosting is added.
NEVERSOFT_REPOS_HOST_ORG_NAME="ether4o4"
